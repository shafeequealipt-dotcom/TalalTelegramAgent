# ---- Talal Homeo blog agent — copy to ".env" (in this agent/ folder) on the
# server and fill in, OR export these as real system env vars (preferred —
# see the project's global secrets rule: secrets live in the shell env, never
# committed to a file). This .env is read as a FALLBACK only.

# Cloudflare Workers AI (content generation — OpenAI-compatible)
TALAL_CloudFlare_API=...
TALAL_CloudFlare_AccountID=...
# Optional: override the default model (also switchable via `python -m agent.cli set-model`)
DEFAULT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---- Website repo (publish target) — a DEDICATED clone of the site repo,
#      separate from anyone's personal working checkout ----
# Fine-grained PAT with "Contents: Read and write" on shafeequealipt-dotcom/TalalHomeo
TALAL_GitHub_Token=github_pat_...
SITE_GITHUB_REPO=shafeequealipt-dotcom/TalalHomeo
# Dedicated local clone of the SITE repo that this agent commits into (absolute path)
REPO_DIR=/opt/talal-agent/TalalHomeo
SITE_URL=https://drtalalhomeo.in

# ---- This agent's OWN repo (used only by `agent.cli set-prompt` to commit
#      content_prompt.txt) ----
# If your PAT above already has write access to this repo too, you can leave
# AGENT_GitHub_Token unset and it'll reuse TALAL_GitHub_Token.
AGENT_GITHUB_REPO=shafeequealipt-dotcom/TalalTelegramAgent
#AGENT_GitHub_Token=github_pat_...

# ---- Google Business Profile auto-post (OPTIONAL — stays off until ALL five
#      are set). One-time setup is in SETUP.md; the refresh token + ids come from
#      `python3 -m agent.gbp_auth login` / `discover`. Toggle with
#      `python -m agent.cli gbp on|off`; button with `gbp cta call|learn`.
#TALAL_GBP_ClientID=xxxxx.apps.googleusercontent.com
#TALAL_GBP_ClientSecret=GOCSPX-...
#TALAL_GBP_RefreshToken=1//...
#TALAL_GBP_AccountID=1234567890
#TALAL_GBP_LocationID=9876543210
# Optional: public https image attached to every GBP post (unset = no image).
#TALAL_GBP_PostImageURL=https://drtalalhomeo.in/some-banner.jpg
