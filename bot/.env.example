# ---- Talal Homeo blog agent — copy to ".env" (in this bot/ folder) on the
# server and fill in, OR export these as real system env vars (preferred —
# see the project's global secrets rule: secrets live in the shell env, never
# committed to a file). This .env is read as a FALLBACK only.

# Telegram (bot token from @BotFather, your numeric chat id from @userinfobot)
TALAL_Telegram_Token=...
TALAL_Telegram_ID=...

# Cloudflare Workers AI (content generation — OpenAI-compatible)
TALAL_CloudFlare_API=...
TALAL_CloudFlare_AccountID=...
# Optional: override the default model (also switchable live via Telegram /setmodel)
DEFAULT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ---- Website repo (publish target) — an EXISTING, separate repo ----
# Fine-grained PAT with "Contents: Read and write" on shafeequealipt-dotcom/TalalHomeo
TALAL_GitHub_Token=github_pat_...
SITE_GITHUB_REPO=shafeequealipt-dotcom/TalalHomeo
# Local working clone of the SITE repo that this agent commits into (absolute path)
REPO_DIR=/opt/talalhomeo/TalalHomeo
SITE_URL=https://drtalalhomeo.in

# ---- This agent's OWN repo (used only by /setprompt to commit content_prompt.txt) ----
# If your PAT above already has write access to this repo too, you can leave
# AGENT_GitHub_Token unset and it'll reuse TALAL_GitHub_Token.
AGENT_GITHUB_REPO=shafeequealipt-dotcom/TalalTelegramAgent
#AGENT_GitHub_Token=github_pat_...

# Daily post WINDOW, 24h, in IST (Asia/Kolkata). A fresh random minute inside
# this window is picked each day (also switchable live via Telegram /settime).
POST_WINDOW_START=06:00
POST_WINDOW_END=09:00
